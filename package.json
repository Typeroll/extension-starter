{
  "name": "typeroll-extension-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starter repository for externally hosted Typeroll Extensions",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/sync-manifest.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "manifest:sync": "node scripts/sync-manifest.mjs",
    "manifest:validate": "node scripts/validate-manifest.mjs",
    "check": "npm run build && npm test && npm run manifest:validate",
    "extension:validate": "npx --package @typeroll/mcp-server typeroll extension validate",
    "extension:push": "npx --package @typeroll/mcp-server typeroll extension push --draft",
    "extension:install": "npx --package @typeroll/mcp-server typeroll extension install",
    "extension:promote": "npx --package @typeroll/mcp-server typeroll extension promote"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
