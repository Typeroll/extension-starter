# Local ports. The defaults work with `npm run dev`.
FRONTEND_PORT=5173
PORT=8787
BASE_PATH=
EXTENSION_VERSION=1.0.0

# Explicitly set by scripts/dev.mjs. Never enable in a deployed environment.
TYPEROLL_LOCAL_DEVELOPMENT=0

# Created in Typeroll under Developer → Extensions.
TYPEROLL_CLIENT_ID=
TYPEROLL_CLIENT_SECRET=

# Must match the secret installation config used for lifecycle events.
TYPEROLL_EVENT_SECRET=

# Production only: absolute path or file: URL to a compiled module exporting
# createProviderStorage(). In-memory storage is intentionally local-only.
PROVIDER_STORAGE_MODULE=
