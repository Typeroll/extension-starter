{
  "schema_version": 1,
  "id": "com.example.quote-extension",
  "name": "Quote Extension",
  "version": "1.0.0",
  "runtime_compatibility": ">=0.35.0 <1.0.0",
  "distribution": "private",
  "developer": {
    "name": "Example provider",
    "support_url": "https://extension.example.com/support",
    "privacy_url": "https://extension.example.com/privacy"
  },
  "permissions": [
    {
      "scope": "content:read",
      "reason": "Reads product content when composing quotes."
    }
  ],
  "auth": {
    "pairing_url": "https://extension.example.com/typeroll/pair"
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "heading_default": {
        "type": "string",
        "title": "Default heading",
        "public": true
      },
      "event_webhook_secret": {
        "type": "string",
        "format": "secret",
        "title": "Lifecycle signing secret"
      }
    },
    "required": [
      "event_webhook_secret"
    ]
  },
  "frontend": {
    "components": [
      {
        "id": "quote",
        "label": "Quote approval",
        "category": "custom",
        "description": "Open and approve a recipient-specific quote.",
        "render_mode": "bundled_component",
        "props_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heading": {
              "type": "string",
              "title": "Heading",
              "default": "Your quote"
            }
          }
        },
        "url_context": {
          "query": [
            {
              "name": "quote",
              "expose_as": "quote_token",
              "sensitive": true,
              "consume": true,
              "max_length": 256,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          ]
        },
        "entry": {
          "script_url": "https://extension.example.com/assets/1.0.0/index.js",
          "script_sha256": "fab7b97c312f827fa70ed00f0162503447b0892eed4d1a6c6c8c93e878e36c81",
          "style_url": "https://extension.example.com/assets/1.0.0/index.css",
          "style_sha256": "d047c95211feece573635bdc4e7aaaae507f4452a851fc91a331b04fbf8f6024"
        },
        "unavailable_message": "The quote service is temporarily unavailable."
      }
    ]
  },
  "admin": {
    "pages": [
      {
        "id": "quotes",
        "label": "Quotes",
        "launch_url": "https://extension.example.com/admin/launch",
        "minimum_permission": "write"
      }
    ]
  },
  "gateway": {
    "base_url": "https://extension.example.com/typeroll",
    "routes": [
      {
        "path": "/quotes/*",
        "methods": [
          "GET",
          "POST"
        ],
        "max_body_bytes": 65536,
        "max_response_bytes": 262144,
        "timeout_ms": 5000
      }
    ]
  },
  "events": {
    "subscriptions": [
      "extension.installed",
      "extension.updated",
      "extension.disabled",
      "extension.uninstalled",
      "extension.credential_rotated"
    ],
    "webhook_url": "https://extension.example.com/typeroll/events",
    "secret_config_key": "event_webhook_secret"
  },
  "data_handling": {
    "personal_data": true,
    "data_location": "EU",
    "retention_url": "https://extension.example.com/privacy#retention"
  }
}
