{
  "schema_version": 1,
  "id": "com.example.quote-extension",
  "name": "Quote Extension",
  "version": "1.1.0",
  "runtime_compatibility": ">=0.36.0 <1.0.0",
  "distribution": "private",
  "developer": {
    "name": "Example provider",
    "support_url": "https://extension.example.com/support",
    "privacy_url": "https://extension.example.com/privacy"
  },
  "permissions": [
    {
      "scope": "forms:submit",
      "reason": "Stores calculator leads in the explicitly bound Typeroll form."
    }
  ],
  "auth": {
    "pairing_url": "https://extension.example.com/typeroll/pair"
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "heading_default": {
        "type": "string",
        "title": "Default heading",
        "public": true
      },
      "event_webhook_secret": {
        "type": "string",
        "format": "secret",
        "title": "Lifecycle signing secret"
      }
    },
    "required": [
      "event_webhook_secret"
    ]
  },
  "frontend": {
    "components": [
      {
        "id": "quote",
        "label": "Quote calculator",
        "category": "custom",
        "description": "Calculate a price, capture a lead, or open a recipient-specific quote.",
        "render_mode": "bundled_component",
        "props_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heading": {
              "type": "string",
              "title": "Heading",
              "default": "Your quote"
            }
          }
        },
        "url_context": {
          "query": [
            {
              "name": "quote",
              "expose_as": "quote_token",
              "sensitive": true,
              "consume": true,
              "max_length": 256,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          ]
        },
        "form_bindings": [
          {
            "id": "lead",
            "form_id": "quote-leads"
          }
        ],
        "entry": {
          "script_url": "https://extension.example.com/assets/1.1.0/index.js",
          "script_sha256": "6af5acefa59c6018494e1cd3809800e013ee240dc34d6dc3cff69c0110c3ffa5",
          "style_url": "https://extension.example.com/assets/1.1.0/index.css",
          "style_sha256": "0556c34db77fe960af72118dcab2467ba1bd5d2be29d7086ec5122a1d0941502"
        },
        "unavailable_message": "The quote service is temporarily unavailable."
      }
    ]
  },
  "admin": {
    "pages": [
      {
        "id": "quotes",
        "label": "Quotes",
        "launch_url": "https://extension.example.com/admin/launch",
        "minimum_permission": "write"
      }
    ]
  },
  "gateway": {
    "base_url": "https://extension.example.com/typeroll",
    "routes": [
      {
        "path": "/quotes/*",
        "methods": [
          "GET",
          "POST"
        ],
        "max_body_bytes": 65536,
        "max_response_bytes": 262144,
        "timeout_ms": 5000
      }
    ]
  },
  "events": {
    "subscriptions": [
      "extension.installed",
      "extension.updated",
      "extension.disabled",
      "extension.uninstalled",
      "extension.credential_rotated"
    ],
    "webhook_url": "https://extension.example.com/typeroll/events",
    "secret_config_key": "event_webhook_secret"
  },
  "data_handling": {
    "personal_data": true,
    "data_location": "EU",
    "retention_url": "https://extension.example.com/privacy#retention"
  }
}
